<div class="row home-bg flex-lg-row-reverse align-item-center g-5 py-4 mb-4">
    <div class=" col-12 col-lg-6">
        <img src="/images/hero-image.png" width="607" height="510" class="d-block mx-lg-auto img-fluid" loading="lazy"
            alt="Cooking Blog">
    </div>

    <div class=" col-12 col-lg-6">
        <h1>Huge Selection Of Delecious Recipe Ideas</h1>
        <p class="lead">
            Lorem ipsum dolor sit amet consectetur adipisicing elit. Consequatur, eveniet. Eos, aliquam.
            Nemo, fugiat
            deserunt. Provident vel possimus odio in iste similique voluptas error magni eveniet dolor?
            Adipisci, quidem
            impedit?
        </p>

        <div class="d-grid gap-2 d-md-flex justify-content-md-start">
            <a href="/explore-latest" class="btn btn-primary btn-dark btn-lg px-4 me-md-2">Explore
                Latest</a>
        </div>

    </div>

    <!-- categories start  -->

    <div class="row row-cols-2 row-cols-lg-6 g-lg-3 py-4">

        <% data.forEach(function(food) { %>
            <a href="/categories/<%=food.name%>" class="col text-center category__link ">
                <div class="category__img shadow">
                    <img src="/uploads/<%=food.image%>" alt="">
                </div>
                <div class="pt-1">
                    <%=food.name%>
                </div>
            </a>
            <% }); %>


                <a href="/categories" class="col text-center category__link ">
                    <div class="category__img shadow">
                        <img src="/images/view-all.jpg" alt="view all categories" loading="lazy">
                    </div>
                    <div class="pt-1"> View All</div>
                </a>


    </div>
    <!-- categories end -->


    <!-- Latest start -->

    <section class="pb-4 pt-4 ">
        <div class="d-flex mb-2 align-item-center ">
            <h2>Latest Recipe</h2>
            <a href="/explore-latest" class="ms-auto">View More</a>
        </div>

        <div class="row row-cols-2 row-cols-lg-5 g-2 g-lg-3 ">

            
            <% if(food !='' ){ %>
                <% food.latest.forEach(function(data){ %>
                    <a href="/recipe/<%= data._id%>" class="col text-center category__link">
                        <div class="category__img category__img--large shadow">
                            <img src="/uploads/<%= data.image%>" alt="view all categories" loading="lazy">
                        </div>
                        <div class="pt-1">
                            <%= data.name%>
                        </div>
                        <div class="pt-1">
                            <p style="color: green; font-size: 12px;">Upload By :  <%= data.username%></p>
                        </div>
                    </a>
                    <% }) %>
                        <% } %>

        </div>

    </section>
    <!-- Latest end -->





    <!-- Thai recipe start -->

    <section class="pb-4 pt-4 ">
        <div class="d-flex mb-2 align-item-center ">
            <h2>Thai Recipe</h2>
            <a href="/categories/Thai" class="ms-auto">View More</a>
        </div>

        <div class="row row-cols-2 row-cols-lg-5 g-2 g-lg-3 ">

            <% if( typeof food.thai!=='undefined' && food.thai.length> 0){ %>
                <% food.thai.forEach(function(data){ %>
                    <a href="/recipe/<%= data._id%>" class="col text-center category__link">
                        <div class="category__img category__img--large shadow">
                            <img src="/uploads/<%= data.image%>" alt="view all categories" loading="lazy">
                        </div>
                        <div class="pt-1">
                            <%= data.name%>
                        </div>
                        <div class="pt-1">
                            <p style="color: green; font-size: 12px;">Upload By :  <%= data.username%></p>
                        </div>
                    </a>
                    <% }) %>
                        <% }else{ %>
                            <p style="color: brown;">NO Items Found</p>
                            <% }%>
        </div>

    </section>
    <!-- Thai recipe end -->



    <!-- american recipe start -->

    <section class="pb-4 pt-4 ">
        <div class="d-flex mb-2 align-item-center ">
            <h2>American Recipe</h2>
            <a href="/categories/American" class="ms-auto">View More</a>
        </div>

        <div class="row row-cols-2 row-cols-lg-5 g-2 g-lg-3 ">

            <% if( typeof food.american !=='undefined' && food.american.length> 0){ %>
                <% food.american.forEach(function(data){ %>
                    <a href="/recipe/<%= data._id%>" class="col text-center category__link">
                        <div class="category__img category__img--large shadow">
                            <img src="/uploads/<%= data.image%>" alt="view all categories" loading="lazy">
                        </div>
                        <div class="pt-1">
                            <%= data.name%>
                        </div>
                        <div class="pt-1">
                            <p style="color: green; font-size: 12px;">Upload By :  <%= data.username%></p>
                        </div>
                    </a>
                    <% }) %>
                        <% }else{ %>
                            <p>NO Items Found</p>
                            <% }%>

        </div>

    </section>
    <!-- american recipe end -->




    <!-- chines recipe start -->

    <section class="pb-4 pt-4 ">
        <div class="d-flex mb-2 align-item-center ">
            <h2>Chinese Recipe</h2>
            <a href="/categories/Chines" class="ms-auto">View More</a>
        </div>

        <div class="row row-cols-2 row-cols-lg-5 g-2 g-lg-3 ">

            <% if( typeof food.chines !=='undefined' && food.chines.length> 0){ %>
                <% food.chines.forEach(function(data){ %>
                    <a href="/recipe/<%= data._id%>" class="col text-center category__link">
                        <div class="category__img category__img--large shadow">
                            <img src="/uploads/<%= data.image%>" alt="view all categories" loading="lazy">
                        </div>
                        <div class="pt-1">
                            <%= data.name%>
                        </div>
                        <div class="pt-1">
                            <p style="color: green; font-size: 12px;">Upload By :  <%= data.username%></p>
                        </div>
                    </a>
                    <% }) %>
                        <% }else{ %>
                            <p>NO Items Found</p>
                            <% }%>
        </div>

    </section>
    <!-- chines recipe end -->




    <!-- submit start -->

    <section class="px-4 py-5 my-5 text-center" id="submit-recipe">
        <img src="/images/publish-recipe.png" alt="" class="d-block mx-auto mb-4 img-fluid" width="566" height="208"
            loading="lazy">
        <h1 class="display-5 fw-bold ">Publish Your Recipe For Free Today</h1>
        <div class="col-lg-6 mx-auto">
            <p class="lead mb-4">Publish your recipein front of thousand of people for free. You get
                backlink to your
                blog</p>
            <div class="d-grid gap-2 d-sm-flex justify-content-sm-center">
                <a href="/admin" class="btn btn-primary btn-dark btn-lg">Submit Recipe</a>
            </div>
        </div>
    </section>



    <!-- submit end -->