<header id="header">
    <nav>
        <div class="container">
            <div class="text-center admin-header">
                <a href="/" class="nav-brand text-dark display-5 ">USER DASHBOARD</a>
            </div>
        </div>
    </nav>
</header>

<div class="container">
    <div class="col-12 my-3 d-flex justify-content-between">
        <a href="/user-insert-recipe"><button type="button" class="btn btn-outline-success ">INSERT
                RECIPE</button></a>
        <div>
            <p style="color: rgba(119, 119, 119, 0.926); font-size: 20px;">Welcome, <%= username%></p>
        </div>
        <a href="/user-login">
            <div class="col-12  ">
                <button type="button" class="btn btn-outline-warning">LOGOUT</button>
            </div>
        </a>
    </div>
    <!-- form handling -->
    <form method="get">
        <table class="table">



            <% if(userRecipe.length> 0 ){ %>
                <thead class="thead-dark">
                    <tr>
                        <th>Recipe Image</th>
                        <th>Recipe Name</th>
                        <th>Category</th>
                        <th>Update</th>
                        <th>Delete</th>
                        <th>Username</th>
                    </tr>
                </thead>
                <% userRecipe.forEach(function(data) { %>

                    <tbody>
                        <tr>
                            <td class="admin-pic align-middle">
                                <a href="#">
                                    <img src="/uploads/<%= data.image%>" alt="">
                                </a>
                            </td>
                            <td class="align-middle">
                                <%= data.name%>
                            </td>

                            <td class="align-middle">
                                <%= data.category%>
                            </td>
                            <td class="align-middle">
                                <a href="/user-update-recipe/<%= data._id%>/user"
                                    class="btn border-shadow update admin-icon">

                                    <span class="text-gradient ">
                                        <i class="bi bi-highlighter"></i>
                                    </span>

                                </a>
                            </td>
                            <td class="align-middle">

                                <a href="/user-delete-recipe/<%= data._id%>"
                                    class="btn border-shadow delete admin-icon">
                                    <span class="text-gradient admin-icon">
                                        <i class="bi bi-archive-fill"></i>
                                    </span>
                                </a>

                            </td>
                            <td class="align-middle">
                                <%= data.username%>
                            </td>
                        </tr>
                        <% }) %>

                            <% }else{ %>
                                <h2 style="color: brown; font-size: 20px;" class="mt-5">You Aren't Upload Any Recipe
                                </h2>
                                <% } %>







                    </tbody>
        </table>
    </form>
</div>